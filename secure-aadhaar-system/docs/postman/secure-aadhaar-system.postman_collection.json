                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/submissions/{{reference_id}}/decrypt",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "submissions", "{{reference_id}}", "decrypt"]
            },
            "description": "reference_id is set automatically by Flow A4. This is the one moment the real Aadhaar number appears in a response."
          },
          "response": []
        },
        {
          "name": "C5 - Admin log out",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/api/admin/logout", "host": ["{{base_url}}"], "path": ["api", "admin", "logout"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Flow D - Sub-admin management (master only)",
      "item": [
        {
          "name": "D1 - Start sub-admin creation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set('registration_token', body.registration_token);",
                  "    pm.environment.set('manual_secret', body.manual_secret);",
                  "    console.log('Enter this secret into the sub-admin\\'s authenticator app:', body.manual_secret);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{sub_admin_username}}\",\n  \"password\": \"{{sub_admin_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/admins/start",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "admins", "start"]
            },
            "description": "Requires an active admin_session with role=master (run Flow C1 first)."
          },
          "response": []
        },
        {
          "name": "D2 - Confirm sub-admin creation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set('sub_admin_id', pm.response.json().admin_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registration_token\": \"{{registration_token}}\",\n  \"totp_code\": \"{{totp_code}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/admins/confirm",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "admins", "confirm"]
            },
            "description": "Fill totp_code with a fresh code from the sub-admin's authenticator (seeded with manual_secret from D1). Response includes containers_granted — how many pre-existing records were retroactively re-wrapped for this new sub-admin."
          },
          "response": []
        },
        {
          "name": "D3 - List all admins",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/admin/admins", "host": ["{{base_url}}"], "path": ["api", "admin", "admins"] }
          },
          "response": []
        },
        {
          "name": "D4 - Log out master, log in as sub-admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{sub_admin_username}}\",\n  \"password\": \"{{sub_admin_password}}\",\n  \"totp_code\": \"{{totp_code}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/admin/login", "host": ["{{base_url}}"], "path": ["api", "admin", "login"] },
            "description": "Run C5 (admin logout) first, then fill totp_code with a fresh code from the SUB-ADMIN's authenticator before sending."
          },
          "response": []
        },
        {
          "name": "D5 - Sub-admin decrypts a pre-existing record",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/submissions/{{reference_id}}/decrypt",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "submissions", "{{reference_id}}", "decrypt"]
            },
            "description": "Proves the retroactive re-wrap from D2 actually works: this record was submitted before the sub-admin existed."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Flow E - Audit report, PDF export, and audit log",
      "item": [
        {
          "name": "E1 - Date-range hit report (JSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/audit-report?from_date={{from_date}}&to_date={{to_date}}",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "audit-report"],
              "query": [
                { "key": "from_date", "value": "{{from_date}}" },
                { "key": "to_date", "value": "{{to_date}}" }
              ]
            },
            "description": "Requires any admin session (master or sub). One row per HIT, not per record: a record submitted once and later decrypted twice shows up as 3 rows, each with its own request_datetime. Dates with zero hits get a single placeholder row."
          },
          "response": []
        },
        {
          "name": "E2 - Date-range report as PDF (all columns)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is application/pdf', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.eql('application/pdf');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/audit-report/pdf?from_date={{from_date}}&to_date={{to_date}}",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "audit-report", "pdf"],
              "query": [
                { "key": "from_date", "value": "{{from_date}}" },
                { "key": "to_date", "value": "{{to_date}}" }
              ]
            },
            "description": "Binary PDF response — in Postman, use the Send and Download button (dropdown next to Send) to save it to disk instead of viewing raw bytes."
          },
          "response": []
        },
        {
          "name": "E3 - Date-range report as PDF (selected columns)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is application/pdf', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.eql('application/pdf');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/audit-report/pdf?from_date={{from_date}}&to_date={{to_date}}&columns=date,masked_aadhaar_no,request_datetime",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "audit-report", "pdf"],
              "query": [
                { "key": "from_date", "value": "{{from_date}}" },
                { "key": "to_date", "value": "{{to_date}}" },
                { "key": "columns", "value": "date,masked_aadhaar_no,request_datetime" }
              ]
            },
            "description": "columns is a comma-separated subset of: date, reference_id, masked_aadhaar_no, request_datetime. Omit the param entirely for all four (see E2)."
          },
          "response": []
        },
        {
          "name": "E4 - Audit log (every login/logout/submit/decrypt event)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('events are newest first', () => {",
                  "    const events = pm.response.json();",
                  "    const timestamps = events.map(e => e.ts);",
                  "    pm.expect(timestamps).to.eql([...timestamps].sort().reverse());",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/audit-log?from_date={{from_date}}&to_date={{to_date}}",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "audit-log"],
              "query": [
                { "key": "from_date", "value": "{{from_date}}" },
                { "key": "to_date", "value": "{{to_date}}" }
              ]
            },
            "description": "Real per-hit timestamps for admin_login, admin_logout, user_login, user_logout, submit, and decrypt events — this is the fix for 'the audit report only shows the last sign-in, not every timestamp.' Run this after Flows A-D so there's something to see."
          },
          "response": []
        }
      ]
    }
  ]
}

                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/admin/me", "host": ["{{base_url}}"], "path": ["api", "admin", "me"] }
          },
          "response": []
        },
        {
          "name": "C3 - List all submissions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/submissions",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "submissions"]
            }
          },
          "response": []
        },
        {
          "name": "C4 - Decrypt a submission",
          "event": [
            {
              "listen": "test",
              "script": {

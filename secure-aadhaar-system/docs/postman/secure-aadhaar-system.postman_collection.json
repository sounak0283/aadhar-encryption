{
  "info": {
    "_postman_id": "a3f1c9d2-4b7e-4f6a-9c2d-1e6f8b0a2c33",
    "name": "Secure Aadhaar Transmission System",
    "description": "Full backend walkthrough — user auth, submission, admin registration, admin session, sub-admin management, and audit reporting/logging. Mirrors docs/POSTMAN_TESTING_GUIDE.md Flows A-E.\n\nImport the sibling environment file too, and select it before running. Auth is httpOnly session cookies (user_session / admin_session) — Postman's desktop app stores and resends these automatically, just like a browser, so nothing needs to be copied into headers manually.\n\nEndpoints requiring a TOTP code (`admin/login`, `admin/register/confirm`, `admin/admins/confirm`) need a live 6-digit code typed into the `totp_code` environment variable immediately before sending — it rotates every 30 seconds.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body is {status: ok}', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Flow A - User auth + submission",
      "item": [
        {
          "name": "A1 - Sign up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 (or 409 if already signed up)', () => {",
                  "    pm.expect([200, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{user_username}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/auth/signup", "host": ["{{base_url}}"], "path": ["api", "auth", "signup"] }
          },
          "response": []
        },
        {
          "name": "A2 - Log in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('user_session cookie is set', () => {",
                  "    pm.expect(pm.cookies.has('user_session')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{user_username}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          },
          "response": []
        },
        {
          "name": "A3 - Confirm logged in (me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('username matches', () => {",
                  "    pm.expect(pm.response.json().username).to.eql(pm.environment.get('user_username'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api", "auth", "me"] }
          },
          "response": []
        },
        {
          "name": "A4 - Submit Aadhaar number",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set('reference_id', pm.response.json().reference_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aadhaar_number\": \"102938475615\",\n  \"consent\": true,\n  \"ts\": \"{{$isoTimestamp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/aadhaar", "host": ["{{base_url}}"], "path": ["api", "aadhaar"] },
            "description": "consent must be exactly true. ts uses Postman's built-in {{$isoTimestamp}} dynamic variable so it's always fresh — the server rejects requests more than 5 minutes old or timestamped in the future. Other valid test Aadhaar numbers: 564738291043, 999888777669."
          },
          "response": []
        },
        {
          "name": "A5 - List my submissions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/my-submissions",
              "host": ["{{base_url}}"],
              "path": ["api", "my-submissions"]
            }
          },
          "response": []
        },
        {
          "name": "A6 - Log out",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/api/auth/logout", "host": ["{{base_url}}"], "path": ["api", "auth", "logout"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Flow B - First admin (master) registration",
      "item": [
        {
          "name": "B1 - Registration status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/register/status",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "register", "status"]
            }
          },
          "response": []
        },
        {
          "name": "B2 - Start registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 (or 409 if an admin already exists)', () => {",
                  "    pm.expect([200, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set('registration_token', body.registration_token);",
                  "    pm.environment.set('manual_secret', body.manual_secret);",
                  "    console.log('Enter this secret into your authenticator app:', body.manual_secret);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"setup_token\": \"{{setup_token}}\",\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/register/start",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "register", "start"]
            },
            "description": "setup_token must match ADMIN_SETUP_TOKEN in backend/.env. After sending, check the Postman console (View > Show Postman Console) for manual_secret, or decode qr_code_png_base64 from the response body as a data:image/png;base64,... URL in a browser to scan it."
          },
          "response": []
        },
        {
          "name": "B3 - Confirm registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registration_token\": \"{{registration_token}}\",\n  \"totp_code\": \"{{totp_code}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/register/confirm",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "register", "confirm"]
            },
            "description": "Fill totp_code with a live 6-digit code from your authenticator app (seeded with manual_secret from B2) and send immediately — it rotates every 30s."
          },
          "response": []
        }
      ]
    },

# Secure Aadhaar Transmission System — frontend environment
# Copy to .env and adjust if the backend isn't running on the default port.

# Must use the same hostname as the frontend itself (both "localhost", not a
# mix of "localhost" and "127.0.0.1") — browsers treat those as different
# sites, which breaks the admin session cookie's SameSite=Strict attribute
# even though both resolve to loopback.
VITE_API_BASE_URL=http://localhost:8000

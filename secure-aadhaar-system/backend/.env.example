# Secure Aadhaar Transmission System — backend environment
# Copy this file to .env and fill in real values. Never commit .env — it's
# already in .gitignore. Every variable below is read via app/config.py
# unless noted otherwise (AWS credentials are read directly by boto3/botocore).

# ============================================================================
# Core app secrets (required for every deployment, local or production)
# ============================================================================

# 32-byte base64 key used to encrypt/decrypt the admin's TOTP secret at rest.
# This is a server secret, not the admin's password — TOTP verification is
# independent of, and happens before, the password-derived private-key unlock.
# Generate one with:
#   python -c "import nacl.utils, base64; print(base64.b64encode(nacl.utils.random(32)).decode())"
APP_TOTP_KEY=

# Required before the web admin-registration page (frontend /admin/register)
# will work at all — POST /api/admin/register/start rejects every request
# without the matching token. This is what stops a stranger from reaching
# an unconfigured deployment and registering themselves as the permanent
# admin before you do. Not needed for scripts/bootstrap_admin.py (CLI,
# already requires shell access to this machine). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Give it to the real operator out of band (not over the same channel as
# the app itself) and delete/rotate it once registration is done.
ADMIN_SETUP_TOKEN=

# ============================================================================
# Sender signing identity (optional override)
# ============================================================================

# Base64-encoded Ed25519 signing key. If unset, app/services/admin_identity_service.py
# falls back to reading backend/secrets/sender_signing_key.b64 (what
# bootstrap_admin.py writes). Set this explicitly in production once that key
# lives in a secrets manager instead of on disk.
SENDER_SIGNING_KEY_B64=

# ============================================================================
# MongoDB
# ============================================================================

# Defaults to mongodb://localhost:27017 if unset — fine for local dev with
# Docker Compose (Phase 0/6). Use a full connection string (with auth + TLS
# query params) for any shared/production database.
MONGO_URI=mongodb://localhost:27017

# Defaults to "secure_aadhaar" if unset.
MONGO_DB_NAME=secure_aadhaar

# ============================================================================
# CORS
# ============================================================================

# The one origin allowed to call this API with credentials (cookies). Defaults
# to the local Vite dev server if unset. Must be your real frontend origin in
# production — CORS + allow_credentials=True never permits "*".
FRONTEND_ORIGIN=http://localhost:5173

# ============================================================================
# Admin identity provider — which one bootstrap_admin.py sets up
# ============================================================================

# "local"   — X25519 keypair, private key encrypted at rest under the admin's
#             password (Argon2id). No AWS dependency. Use for dev/test.
# "aws-kms" — admin identity key lives inside AWS KMS (ECC P-256), never
#             exported. Requires the AWS_* variables below. Runtime provider
#             selection actually comes from admin_identity.json's own
#             "key_provider" field (see README Data Model) — this variable
#             only tells bootstrap tooling which kind of identity to create.
#             kms_provider.py is implemented but only mock-tested so far —
#             see README Open Decisions before using it for anything real.
ADMIN_KEY_PROVIDER=local

# ============================================================================
# AWS KMS (only needed when ADMIN_KEY_PROVIDER=aws-kms)
# ============================================================================

# Region containing the KMS key. Read directly by boto3; can also come from
# an AWS_PROFILE's config instead of being set here.
AWS_REGION=

# ARN (or key ID) of the ECC_NIST_P256 KEY_AGREEMENT key used for the admin
# identity. Created once via the AWS console/CLI (see README/chat for the
# exact command) — bootstrap_admin.py verifies it and writes the ARN into
# backend/secrets/admin_identity.json as "kms_key_arn". This variable is
# only the bootstrap-time input; the running app reads the ARN from there.
AWS_KMS_KEY_ID=

# --- AWS credentials: prefer NOT setting these at all ---
# Production (EC2/ECS/Fargate/Lambda): attach an IAM role/instance profile to
# the compute resource instead — boto3 picks it up automatically, and no
# credentials ever need to exist in this file.
# Local dev against real AWS: prefer a named profile (`aws configure --profile
# secure-aadhaar`) and set only AWS_PROFILE below — avoids putting raw secret
# keys in a plaintext file at all.
AWS_PROFILE=

# Last resort for quick local testing only — short-lived credentials (e.g.
# from `aws sts get-session-token` or SSO), never a root/long-term IAM user's
# keys, and never committed:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
